{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CTI · Iniciar Spring Boot",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/BackEnd" },
      "problemMatcher": []
    },
    {
      "label": "CTI · Iniciar Vue",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/FrontEnd" },
      "problemMatcher": []
    },
    {
      "label": "CTI · Iniciar FastAPI",
      "type": "process",
      "command": "${workspaceFolder}/analytics-python/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/analytics-python/.venv/Scripts/python.exe" },
      "args": ["-m", "uvicorn", "api:app", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/analytics-python" },
      "problemMatcher": []
    }
  ]
}
