# Modelo do ETL Python. Preencha os valores em analytics-python/.env.
# No painel do Neon, abra Connect e selecione a branch, o banco e o usuário.
# DB_HOST recebe apenas o host, como ep-exemplo.us-east-2.aws.neon.tech.
DB_HOST=SEU_HOST_DO_NEON
DB_PORT=5432
DB_NAME=SEU_BANCO_DO_NEON
DB_USER=SEU_USUARIO_DO_NEON
DB_PASSWORD=
DB_SSLMODE=require

# Use o mesmo valor de ETL_API_KEY em BackEnd/.env.
ETL_API_KEY=
